<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <SupportedOSPlatformVersion>28.0</SupportedOSPlatformVersion>
    <ApplicationId>org.pulsepal.phone</ApplicationId>
    <ApplicationTitle>PulsePal Phone</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <AndroidUseAssemblyStore>true</AndroidUseAssemblyStore>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidHttpClientHandlerType>System.Net.Http.SocketsHttpHandler, System.Net.Http</AndroidHttpClientHandlerType>
    <UseNativeHttpHandler>false</UseNativeHttpHandler>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\PulsePal.Connected\PulsePal.Connected.csproj" />
    <TrimmerRootAssembly Include="PulsePal.Connected" RootMode="All" />
    <RuntimeHostConfigurationOption Include="System.Net.Http.UseNativeHttpHandler" Value="false" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug'">
    <Compile Remove="NativeReadInstrumentation.cs" />
  </ItemGroup>
</Project>
